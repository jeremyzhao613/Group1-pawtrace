# Copy to backend/.env. This root file is only a reference.
# Packaging. Use a deployed HTTPS API for public desktop/mobile builds.
PAWTRACE_API_BASE_URL=
# Public web origin used for pet NFC URLs. Keep this reachable by other phones.
PAWTRACE_PUBLIC_APP_URL=https://pawtrace.pages.dev

DATABASE_URL="postgresql://pawtrace:pawtrace@localhost:5432/pawtrace"
JWT_SECRET="change-me"
CORS_ORIGIN=
MONITOR_API_TOKEN=
DEVICE_INGEST_TOKEN=pawtrace-m5-dev-token
DEVICE_DEFAULT_USER=demo
DASHSCOPE_API_KEY=
AI_TIMEOUT_MS=60000
VIDEO_AI_URL=http://127.0.0.1:8008/analyze-video
