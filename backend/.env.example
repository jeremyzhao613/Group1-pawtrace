# Local one-command startup uses scripts/local-db.sh on port 55432.
DATABASE_URL="postgresql://pawtrace@localhost:55432/pawtrace"

# If you use docker compose instead, switch to:
# DATABASE_URL="postgresql://pawtrace:pawtrace@localhost:5432/pawtrace"
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# JWT. Use a strong random secret outside local development.
JWT_SECRET="change-me-in-production"

# AI. Backend only.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.6-plus
QWEN_VISION_MODEL=qwen3.6-plus
QWEN_ENABLE_THINKING=false
AI_TIMEOUT_MS=60000
VIDEO_AI_URL=http://127.0.0.1:8008/analyze-video
VIDEO_AI_TIMEOUT_MS=120000

# Monitor. Required for /api/monitor/*; leave empty to disable monitor API.
MONITOR_API_TOKEN=
MONITOR_MAX=500

# Device ingest. M5Stack can POST telemetry with x-device-token or Authorization: Bearer <token>.
DEVICE_INGEST_TOKEN=pawtrace-m5-dev-token
DEVICE_DEFAULT_USER=demo

# Keep backend as API-only by default. Set SERVE_WEB=1 only for single-port deployment.
SERVE_WEB=0

# Static web app served by backend after build when SERVE_WEB=1: frontend | glass
WEB_APP=frontend
